    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^12.29.0",
    "lucide-react": "^0.487.0",
    "motion": "^12.29.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.2",
    "socket.io-client": "^4.8.3",
