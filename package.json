    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.4.0",
    "vite": "^6.3.5"
