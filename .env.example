# ===========================================
# FirewallAI Dashboard - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# Frontend Configuration
# ===========================================
VITE_BACKEND_URL=http://192.168.1.101:3001
VITE_GRAFANA_URL=http://192.168.1.101:3000
VITE_APP_NAME=FirewallAI Dashboard

# ===========================================
# Backend Configuration (Ubuntu Server)
# ===========================================
# Server settings
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# pfSense SSH credentials
PFSENSE_HOST=192.168.1.1
PFSENSE_USER=admin
PFSENSE_PASSWORD=your_pfsense_password_here

# Ubuntu server credentials (for launcher)
UBUNTU_HOST=192.168.1.101
UBUNTU_USER=ubuntu
UBUNTU_PASSWORD=your_ubuntu_password_here

# ===========================================
# AI/ML Configuration (Ollama)
# ===========================================
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# ===========================================
# Database (InfluxDB)
# ===========================================
INFLUXDB_URL=http://192.168.1.101:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=your_org
INFLUXDB_BUCKET=pfsense

# ===========================================
# Grafana
# ===========================================
GRAFANA_URL=http://192.168.1.101:3000
GRAFANA_DASHBOARD_ID=adx96f4/pfsense-cputest

# ===========================================
# Security
# ===========================================
# Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_session_secret_here

# JWT secret for API authentication
JWT_SECRET=your_jwt_secret_here

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=info
LOG_FILE=/var/log/firewallai/app.log
